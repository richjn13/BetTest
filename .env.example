# For local development: copy this file to .env.local and fill in the values,
# then restart the dev server -- Next.js only reads it on boot.
#
# Deploying from an iPad or straight to Vercel? You never create this file.
# Set the same names and values in Vercel under Settings -> Environment
# Variables, and redeploy afterwards. The README walks through both paths.

# --- Supabase (README step 5) -------------------------------------------
# Project Settings -> API. Copy the SERVICE_ROLE key, not the anon key:
# every table has row-level security on with no policies, so the anon key
# grants nothing. Treat this like a password and never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Secrets you generate (README step 6) -------------------------------
# Run this twice, once for each:  openssl rand -base64 32
# No terminal? Run this in the Supabase SQL editor instead:
#   select encode(gen_random_bytes(32), 'base64');
# Signs the login cookie. Changing it signs everyone out, which is harmless.
SESSION_SECRET=replace-me
# Shared secret the scheduled refresh endpoint requires.
CRON_SECRET=replace-me

# --- Who may start a pool ------------------------------------------------
# The owner key typed on the "Start a group" tab. Leave this blank and nobody
# can create a pool, including you -- which is the right default, since the
# join page is public. Joining an existing pool with a code is unaffected.
CREATE_GROUP_SECRET=

# --- Anthropic (Admin -> Lines -> Pull lines with Claude) ----------------
# https://console.anthropic.com -- powers the on-demand line pull, where Claude
# searches for the week's spreads. Each pulled line is locked at the moment of
# the pull. Leave blank to skip that feature.
ANTHROPIC_API_KEY=
# Optional. Pulls use claude-sonnet-5 unless you name another model here.
# ANTHROPIC_MODEL=claude-sonnet-5

# Where the AP Top 25 is read from. Optional: the NCAA's own rankings page is
# the default. Set this to another page if that one moves.
# AP_POLL_URL=https://www.ncaa.com/rankings/football/fbs/associated-press

# Most tokens one Claude web-search pull may spend before it gives up.
# Optional, defaults to 120000.
# CLAUDE_PULL_TOKEN_BUDGET=120000

# How often a page view may check scores while a game is under way. One call
# per interval no matter how many people are watching, and none when nothing
# is on. Optional, defaults to 10 minutes.
# LIVE_REFRESH_MINUTES=10

# Scheduled score updates stop spending once the month's odds-feed balance
# falls below this, so pulling next week's lines is always still possible.
# Optional, defaults to 50.
# ODDS_API_MIN_REMAINING=50

# --- The Odds API (README step 9) ---------------------------------------
# https://the-odds-api.com -- leave blank to run on hand-entered games.
# Format: the bare key, a plain string of letters and digits with no sk- prefix.
# No quotes, no "Bearer", no "apiKey=" in front. It is sent as a URL parameter,
# so anything wrapped around it becomes part of the key and fails.
# Each scheduled run spends two calls, so read the quota table in the README
# before putting this on a 15-minute schedule.
# One key, or several separated by commas -- a pool run by two people can use
# both their own accounts, and a key with nothing left is passed over for the
# next. Never share one account between people; sign up with your own.
ODDS_API_KEY=

# --- Free scoreboard pages (optional, and the cheapest thing here) -------
# Scores are almost all of what the odds feed's allowance goes on. Point these
# at public scoreboard pages and they are read for nothing, with the feed left
# as a fallback for whatever the page did not say.
# Set one per competition, or SCORES_URL alone for a page covering both.
# NCAAF_SCORES_URL=
# NFL_SCORES_URL=
# SCORES_URL=
# OPTIONAL, and not a credential -- you type this yourself rather than fetching
# it from anywhere. It ranks whose line you prefer when the feed prices the same
# game at several sportsbooks: the first book in the list that has posted a
# spread wins. Leave it blank and the app takes the first book the feed returns,
# which is a fine choice. Common keys: draftkings, fanduel, betmgm, betrivers,
# espnbet, fanatics, bovada, betonlineag.
ODDS_API_BOOKMAKERS=draftkings,fanduel

# --- Optional -----------------------------------------------------------
# Week numbers are derived from the calendar: week 1 opens the Tuesday after
# Labor Day. Set this to that Tuesday (YYYY-MM-DD) only for a season whose
# schedule breaks the rule.
# NFL_WEEK1_TUESDAY=2026-09-08

# --- Dog cam (optional) --------------------------------------------------
# The /dogcam pages: one device at home holds its camera open, another watches
# it live. The picture goes straight between the two devices, so it costs
# nothing to run and nothing is ever recorded.
#
# These pages look inside your home, so they stay locked until you set a
# passcode here. Leave it blank and the whole section is switched off, which is
# the right default for pages anyone could otherwise open with the link.
# Changing the passcode signs every device out.
DOGCAM_PASSCODE=

# OPTIONAL, and the one part of this that can cost money. Two browsers usually
# find a direct path to each other for free. A few networks -- some office and
# guest Wi-Fi especially -- refuse to allow that, and the only way through is a
# relay, which carries every frame and is billed by the gigabyte. Leave these
# blank and there is no relay: the connection simply fails on those networks,
# and everywhere else works as normal.
# DOGCAM_TURN_URL=turn:your-relay.example.com:3478
# DOGCAM_TURN_USERNAME=
# DOGCAM_TURN_CREDENTIAL=
