# Copy this file to .env.local and fill in the values.
# The README's "Get it running" section walks through where each one comes from.
# Restart the dev server after any change here -- Next.js only reads this on boot.

# --- Supabase (README step 5) -------------------------------------------
# Project Settings -> API. Copy the SERVICE_ROLE key, not the anon key:
# every table has row-level security on with no policies, so the anon key
# grants nothing. Treat this like a password and never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Secrets you generate (README step 6) -------------------------------
# Run this twice, once for each:  openssl rand -base64 32
# Signs the login cookie. Changing it signs everyone out, which is harmless.
SESSION_SECRET=replace-me
# Shared secret the scheduled refresh endpoint requires.
CRON_SECRET=replace-me

# --- The Odds API (README step 9) ---------------------------------------
# https://the-odds-api.com -- leave blank to run on hand-entered games.
# Each scheduled run spends two calls, so read the quota table in the README
# before putting this on a 15-minute schedule.
ODDS_API_KEY=
# Comma-separated bookmaker keys, first available wins. Empty = first book returned.
ODDS_API_BOOKMAKERS=draftkings,fanduel

# --- Optional -----------------------------------------------------------
# Week numbers are derived from the calendar: week 1 opens the Tuesday after
# Labor Day. Set this to that Tuesday (YYYY-MM-DD) only for a season whose
# schedule breaks the rule.
# NFL_WEEK1_TUESDAY=2026-09-08
