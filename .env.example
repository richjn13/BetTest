# Supabase project (server-side only; the service role key must never reach the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me

# The Odds API (https://the-odds-api.com)
ODDS_API_KEY=your-odds-api-key
# Comma-separated bookmaker keys, first available wins. Empty = first book returned.
ODDS_API_BOOKMAKERS=draftkings,fanduel

# Shared secret for the Vercel Cron endpoints
CRON_SECRET=replace-me
