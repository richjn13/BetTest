# For local development: copy this file to .env.local and fill in the values,
# then restart the dev server -- Next.js only reads it on boot.
#
# Deploying from an iPad or straight to Vercel? You never create this file.
# Set the same names and values in Vercel under Settings -> Environment
# Variables, and redeploy afterwards. The README walks through both paths.

# --- Supabase (README step 5) -------------------------------------------
# Project Settings -> API. Copy the SERVICE_ROLE key, not the anon key:
# every table has row-level security on with no policies, so the anon key
# grants nothing. Treat this like a password and never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Secrets you generate (README step 6) -------------------------------
# Run this twice, once for each:  openssl rand -base64 32
# No terminal? Run this in the Supabase SQL editor instead:
#   select encode(gen_random_bytes(32), 'base64');
# Signs the login cookie. Changing it signs everyone out, which is harmless.
SESSION_SECRET=replace-me
# Shared secret the scheduled refresh endpoint requires.
CRON_SECRET=replace-me

# --- Anthropic (Admin -> Lines -> Pull lines with Claude) ----------------
# https://console.anthropic.com -- powers the on-demand line pull, where Claude
# searches for the week's spreads. Each pulled line is locked at the moment of
# the pull. Leave blank to skip that feature.
ANTHROPIC_API_KEY=

# --- The Odds API (README step 9) ---------------------------------------
# https://the-odds-api.com -- leave blank to run on hand-entered games.
# Format: the bare key, a plain string of letters and digits with no sk- prefix.
# No quotes, no "Bearer", no "apiKey=" in front. It is sent as a URL parameter,
# so anything wrapped around it becomes part of the key and fails.
# Each scheduled run spends two calls, so read the quota table in the README
# before putting this on a 15-minute schedule.
ODDS_API_KEY=
# OPTIONAL, and not a credential -- you type this yourself rather than fetching
# it from anywhere. It ranks whose line you prefer when the feed prices the same
# game at several sportsbooks: the first book in the list that has posted a
# spread wins. Leave it blank and the app takes the first book the feed returns,
# which is a fine choice. Common keys: draftkings, fanduel, betmgm, betrivers,
# espnbet, fanatics, bovada, betonlineag.
ODDS_API_BOOKMAKERS=draftkings,fanduel

# --- Optional -----------------------------------------------------------
# Week numbers are derived from the calendar: week 1 opens the Tuesday after
# Labor Day. Set this to that Tuesday (YYYY-MM-DD) only for a season whose
# schedule breaks the rule.
# NFL_WEEK1_TUESDAY=2026-09-08
